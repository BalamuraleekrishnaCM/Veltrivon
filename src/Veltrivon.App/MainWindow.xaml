<Window x:Class="Veltrivon.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Veltrivon.App"
    Title="Veltrivon · Windows Control Suite">
    <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False" PaneTitle="Veltrivon" PaneDisplayMode="Auto"
        OpenPaneLength="208" SelectionChanged="Navigate">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="OverviewNav" Content="Overview" Icon="Home" Tag="overview" />
            <NavigationViewItem x:Name="ToolNav" Content="Tool catalog" Icon="AllApps" Tag="tools" />
            <NavigationViewItem x:Name="UpdatesNav" Content="Software updates" Icon="Refresh" Tag="updates" />
            <NavigationViewItem Content="Security checks" Tag="security">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Diagnostics" Icon="Repair" Tag="diagnostics" />
            <NavigationViewItem x:Name="ActivityNav" Content="Activity" Icon="Document" Tag="activity" />
        </NavigationView.MenuItems>
        <Grid x:Name="Root" Padding="28,20,28,24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Description" TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ScrollViewer x:Name="OverviewView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Border CornerRadius="12" Padding="24" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Workstation health" FontSize="26" FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="Review Windows protection, available app updates, and system diagnostics in one scan."
                                TextWrapping="Wrap" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <Button x:Name="OverviewScan" Content="Run workstation check" Click="CheckWorkstation" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Software and tools" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Browse developer tools, verify installations, and see available updates."
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Browse tools" Click="GoToTools" />
                                <Button Content="Software updates" Click="GoToUpdates" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LastOverviewScan" Text="No workstation checks run in this session."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="CatalogView" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Search" PlaceholderText="Search by name or package ID"
                        AutomationProperties.Name="Search tools" TextChanged="FilterChanged" />
                    <ComboBox x:Name="Profile" Grid.Column="1" Width="154"
                        AutomationProperties.Name="Tool profile" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All tools" Tag="" />
                        <ComboBoxItem Content="Essential" Tag="essential" />
                        <ComboBoxItem Content="Extended" Tag="extended" />
                        <ComboBoxItem Content="XR and media" Tag="xr" />
                        <ComboBoxItem Content="Developer" Tag="developer" />
                        <ComboBoxItem Content="Open-source XR" Tag="xr-open" />
                        <ComboBoxItem Content="Optional" Tag="optional" />
                        <ComboBoxItem Content="Manual" Tag="manual" />
                    </ComboBox>
                </Grid>
                <ListView x:Name="Tools" Grid.Row="1" SelectionMode="Multiple"
                    SelectionChanged="ToolSelectionChanged" AutomationProperties.Name="Tool catalog">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CatalogTool">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Id}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="Selection" TextWrapping="Wrap" />
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectVisible" Content="Select visible" Click="SelectTools" Margin="0,0,8,8" />
                        <Button x:Name="Check" Content="Check WinGet" Click="CheckPackages" Margin="0,0,8,8" />
                        <Button x:Name="Test" Content="Test selected" Click="TestPackages" Margin="0,0,8,8" />
                        <Button x:Name="Install" Content="Install selected" Click="InstallPackages"
                            Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                        <Button x:Name="Launch" Content="Run tool" Click="LaunchTool" Margin="0,0,8,8" />
                        <Button x:Name="Website" Content="Publisher website" Click="OpenWebsite" Margin="0,0,8,8" />
                    </StackPanel></ScrollViewer>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="UpdatesView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Button x:Name="CheckUpdates" Content="Check for updates" Click="CheckSoftwareUpdates"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Text="Checks apps WinGet recognizes across configured sources. Review the results in Activity." TextWrapping="Wrap" />
                    <Button x:Name="ListSoftware" Content="List installed software" Click="ListInstalledSoftware" />
                    <Button x:Name="RefreshSources" Content="Refresh WinGet sources" Click="RefreshPackageSources" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SecurityView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel x:Name="SecurityCards" Spacing="12" />
            </ScrollViewer>
            <ScrollViewer x:Name="DiagnosticsView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel x:Name="DiagnosticCards" Spacing="12" />
            </ScrollViewer>
            <Grid x:Name="ActivityView" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open log folder" Click="OpenLogs" />
                    <Button x:Name="ExportReport" Content="Export scan summary" Click="SaveReport" IsEnabled="False" />
                </StackPanel>
                <TextBox x:Name="Activity" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                    TextWrapping="Wrap" AutomationProperties.Name="Job output"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
            <StackPanel Grid.Row="2" Spacing="7">
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
                <Button x:Name="CancelJob" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed" />
                <TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
